# No Raspberry Pi real, use HARDWARE_MODE=simulator.
HARDWARE_MODE=auto

# Ordem: botoeiras 1 a 10. Numeração BCM, não o número físico do conector.
BUTTON_GPIOS_BCM=17,27,22,5,6,26,16,25,18,12
BUTTON_DEBOUNCE=0.04

# 10 anéis WCMCU-2812B-12 em uma única cadeia no SPI0 MOSI / GPIO10 / pino 19.
RING_COUNT=10
LEDS_PER_RING=12
SPI_DEVICE=/dev/spidev0.0
SPI_SPEED_KHZ=800

# Limite de brilho e consumo (0.25 = 25%). A fonte externa continua obrigatória.
LED_BRIGHTNESS=0.25

# Onde as MÚSICAS ENVIADAS pelo usuário são gravadas. Fica FORA da pasta do app
# para que atualizações de código (git pull, unzip por cima, reinstalação) não
# apaguem as músicas. Não delete esta pasta ao atualizar o sistema.
MUSIC_DATA_DIR=/var/lib/music-game
